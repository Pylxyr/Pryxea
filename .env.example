# ─────────────────────────────────────────────────────────────
# Pryxea. The four Twitch values below are required; everything else is
# optional and shown with its default. These names are the same ones the
# Python Twitch Radio used, so an existing .env carries over unchanged.
# ─────────────────────────────────────────────────────────────
# From https://dev.twitch.tv/console/apps. Register an application there
# (OAuth Redirect URL: http://localhost:4343/oauth/callback).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Numeric Twitch user IDs, not usernames. BOT_ID is the account the bot chats
# as; OWNER_ID is the channel it joins.
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

# ─────────────────────────────────────────────────────────────
# Chat commands: !sr <song or URL>, !skip, !nowplaying, !sq, !radio [on|off]
# ─────────────────────────────────────────────────────────────

# ── Audio ────────────────────────────────────────────────────
# Opus bitrate of the stream served to OBS (64-256).
# AUDIO_BITRATE_KBPS=160
# static (default): each song is measured once and a fixed gain plus a
# limiter is applied. off: songs play at their own volume.
# LOUDNESS_MODE=static

# ── Local server (this computer only) ────────────────────────
#   OBS Media Source   -> http://127.0.0.1:8098/stream.opus
#   OBS Browser Source -> http://127.0.0.1:8098/overlay
# TWITCH_NOWPLAYING_PORT=8098
# While nobody is connected to /stream.opus nothing is encoded. Set this to
# true to hold off starting a new track until someone is listening again.
# PAUSE_QUEUE_WHEN_NO_LISTENERS=false

# ── yt-dlp ───────────────────────────────────────────────────
# YTDLP_COOKIES_FILE=data/cookies.txt
# YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416
# YTDLP_JS_RUNTIME_PATH=
# YTDLP_JS_RUNTIME_NAME=deno
# YTDLP_PLAYER_CLIENT=
# YTDLP_CACHE_TTL_SECONDS=900
# YTDLP_CONCURRENCY=2
# YTDLP_WORKER_IDLE_SECONDS=120
# YTDLP_EXTRACT_TIMEOUT_SECONDS=45

# ── Logging ──────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_TO_FILE=true
